# ==========================================
# 1. Physical logic functions
# ==========================================
def ineq_region(alpha, G, B):
    return (B < 3.0 * G) & (B * G + 2.0 * G**2 + 1.0 - alpha * (G + B) < 0)

def kappa_I(alpha, gamma):
    return (1.0 + gamma**2) / (2.0 * (gamma * alpha + 1.0))

def SI(alpha, beta, gamma):
    kI = kappa_I(alpha, gamma).astype(np.complex128)
    A = gamma**2 * (1.0 - 8.0 * kI) + (1.0 - 2.0 * kI) ** 2
    B = gamma**2 * (1.0 - 4.0 * kI) + (1.0 - 2.0 * kI) ** 2
    disc = (A**2 - 16.0 * kI * gamma**2 * (1.0 + 1.0 / (beta**2)) *
            (4.0 * kI**2 * gamma**2 - (1.0 - 2.0 * kI) ** 2 * (1.0 + gamma**2)))
    return (A + np.sqrt(disc)) / (2.0 * B)

def lambda_all(alpha, beta, gamma):
    beta = beta.astype(np.complex128); gamma = gamma.astype(np.complex128); alpha = np.complex128(alpha)
    kI = kappa_I(alpha, gamma).astype(np.complex128); si = SI(alpha, beta, gamma)
    P2 = (-4*beta**2 + 2*si*beta**2 - 7*si**2*beta**2 + 3*si**2*alpha**2*beta**2 + 6*si*alpha*beta**2*gamma - 6*si**2*alpha*beta**2*gamma + 12*beta**2*gamma**2 - 24*si*beta**2*gamma**2 + 12*si**2*beta**2*gamma**2 - 24*si*beta**2*kI + 24*si**2*beta**2*kI + 12*si*alpha**2*beta**2*kI - 12*si**2*alpha**2*beta**2*kI)
    P3 = (-16*beta**3 + 12*si*beta**3 - 30*si**2*beta**3 - 20*si**3*beta**3 + 18*si**2*alpha**2*beta**3 - 72*si**3*alpha**2*beta**3 - 72*si*alpha*beta**3*gamma - 72*si**2*alpha*beta**3*gamma + 144*si**3*alpha*beta**3*gamma - 144*beta**3*gamma**2 + 324*si*beta**3*gamma**2 - 216*si**2*beta**3*gamma**2 + 36*si**3*beta**3*gamma**2 - 144*si*beta**3*kI + 72*si**2*beta**3*kI + 72*si**3*beta**3*kI + 72*si*alpha**2*beta**3*kI - 360*si**2*alpha**2*beta**3*kI + 288*si**3*alpha**2*beta**3*kI - 648*si*alpha*beta**3*gamma*kI + 1296*si**2*alpha*beta**3*gamma*kI - 648*si**3*alpha*beta**3*gamma*kI)
    big_sqrt = np.sqrt(4.0 * (P2**3) + (P3**2)); C = (P3 + big_sqrt) ** (1.0 / 3.0); term1 = -(4.0 / 3.0) * (-beta + si * beta)
    l1 = term1 - (2.0 ** (1.0 / 3.0) * P2) / (3.0 * C) + (1.0 / (3.0 * 2.0 ** (1.0 / 3.0))) * C
    i = 1j
    l2 = term1 + ((1.0 + i * np.sqrt(3.0)) * P2) / (3.0 * (2.0 ** (2.0 / 3.0)) * C) - (1.0 / (6.0 * (2.0 ** (1.0 / 3.0)))) * (1.0 - i * np.sqrt(3.0)) * C
    l3 = term1 + ((1.0 - i * np.sqrt(3.0)) * P2) / (3.0 * (2.0 ** (2.0 / 3.0)) * C) - (1.0 / (6.0 * (2.0 ** (1.0 / 3.0)))) * (1.0 + i * np.sqrt(3.0)) * C
    return l1, l2, l3

def coupled_system(t, y, p, eta_R, eta_I, J_R, J_I, g, kappa, J_Ig, J_Il, Delta):
    a1, a2 = y[0], y[1]; Sigma = y[2:18].reshape((4, 4))
    abs_a1_sq, abs_a2_sq = np.abs(a1)**2, np.abs(a2)**2
    da1_dt = (p - 1j*Delta)*a1 - (eta_I + 1j*eta_R)*abs_a1_sq*a1 + (J_I - 1j*J_R)*a2
    da2_dt = (p - 1j*Delta)*a2 - (eta_I + 1j*eta_R)*abs_a2_sq*a2 + (J_I - 1j*J_R)*a1
    A_L = np.zeros((4, 4), dtype=complex)
    A_L[0,0]=p+1j*Delta+2*(-eta_I+1j*eta_R)*abs_a1_sq; A_L[0,1]=J_I+1j*J_R; A_L[0,2]=-(eta_I-1j*eta_R)*np.conj(a1)**2
    A_L[1,0]=J_I+1j*J_R; A_L[1,1]=p+1j*Delta+2*(-eta_I+1j*eta_R)*abs_a2_sq; A_L[1,3]=-(eta_I-1j*eta_R)*np.conj(a2)**2
    A_L[2,0]=-(eta_I+1j*eta_R)*a1**2; A_L[2,2]=p-1j*Delta+2*(-eta_I-1j*eta_R)*abs_a1_sq; A_L[2,3]=J_I-1j*J_R
    A_L[3,1]=-(eta_I+1j*eta_R)*a2**2; A_L[3,2]=J_I-1j*J_R; A_L[3,3]=p-1j*Delta+2*(-eta_I-1j*eta_R)*abs_a2_sq
    D = np.zeros((4, 4), dtype=complex); D[0,0]=D[1,1]=g+J_Ig; D[0,1]=D[1,0]=J_Ig
    D[2,2], D[3,3]=kappa+J_Il+4*eta_I*abs_a1_sq, kappa+J_Il+4*eta_I*abs_a2_sq; D[2,3]=D[3,2]=J_Il
    return np.concatenate(([da1_dt, da2_dt], (A_L @ Sigma + Sigma @ A_L.conj().T + D).flatten()))

# ==========================================
# 2. Plotting execution
# ==========================================
fig = plt.figure(dpi=100)
gs = gridspec.GridSpec(2, 2, width_ratios=[1.1, 1], hspace=0.25, wspace=0.20)

def set_sci(ax, labelsize_x=32, labelsize_y=32, offsetsize=28, axis='both'):
    if axis in ['both', 'x']:
        ax.xaxis.set_major_formatter(ticker.ScalarFormatter(useMathText=True))
        ax.ticklabel_format(axis='x', style='sci', scilimits=(0,0))
        ax.xaxis.get_offset_text().set_fontsize(offsetsize)
        ax.tick_params(axis='x', labelsize=labelsize_x)
    if axis in ['both', 'y']:
        ax.yaxis.set_major_formatter(ticker.ScalarFormatter(useMathText=True))
        ax.ticklabel_format(axis='y', style='sci', scilimits=(0,0))
        ax.yaxis.get_offset_text().set_fontsize(offsetsize)
        ax.tick_params(axis='y', labelsize=labelsize_y)
    
    ax.tick_params(width=2.0, length=8)
    for spine in ax.spines.values():
        spine.set_linewidth(2.0)

# --- A. Left plot (a) ---
ax1 = fig.add_subplot(gs[:, 0])
alpha_val = 3.0; g_rng, b_rng = (0.0, 2.4), (0.2, 7.0)
gn, bn = np.linspace(g_rng[0], g_rng[1], 400), np.linspace(b_rng[0], b_rng[1], 400)
G, B = np.meshgrid(gn, bn)
l1, l2, l3 = lambda_all(alpha_val, B.astype(np.complex128), G.astype(np.complex128))

ax1.contourf(G, B, (ineq_region(alpha_val, G, B) & ((np.real(l1)>1e-5)|(np.real(l2)>1e-5)|(np.real(l3)>1e-5))).astype(float),
             levels=[0.5, 1.5], colors=[(0.196, 0.804, 0.196, 0.50)], antialiased=False)

points = [(0.25,0.5),(0.5,0.5),(0.5,1),(0.5,1.3),(0.75,0.7),(0.75,1),(0.75,1.5),(0.75,2),(1,1),(1,1.5),(1,2),(1,2.5),(1,2.7),
          (1.25,1),(1.25,1.5),(1.25,2),(1.25,2.5),(1.25,3),(1.25,3.5),(1.5,1.5),(1.5,2),(1.5,2.5),(1.5,3),(1.5,3.5),(1.5,4),(1.5,4.2),
          (1.75,1.6),(1.75,2),(1.75,2.5),(1.75,3),(1.75,3.5),(1.75,4),(1.75,4.5),(1.75,4.8),(1.75,5.2),
          (2,3.5),(2,4),(2,4.5),(2,5),(2,5.3),(2,5.5),(2,5.9),(2.2,5.5),(2.2,6),(2.2,6.2),(2.2,6.5)]
pts = np.array(points)

ax1.scatter(pts[:,0], pts[:,1], c="red", s=80, linewidths=2.0, zorder=5, label=r"$(J_I, p)/\kappa_0, J_R/\kappa_0=1$")
ax1.scatter(pts[:,0], pts[:,1], marker="s", facecolors="none", edgecolors="blue", s=300, linewidths=3.0, zorder=6, label=r"$(J_I, p)/\kappa_0\times10, J_R/\kappa_0=10$")

ax1.set_xlabel(r"$J_I/\kappa_0$", fontsize=38); ax1.set_ylabel(r"$p/\kappa_0$", fontsize=38)
ax1.legend(loc="upper left", fontsize=28, frameon=True)
ax1.set_title(r"$\eta_R/\kappa_0 = 3\times 10^{-4},~\eta_{I}/\kappa_0= 10^{-4}$", fontsize=30); ax1.grid(True, ls="--", alpha=0.3)
# ==== Modified: font size of (a) increased to 34 ====
ax1.text(-0.06, 1.00, "(a)", transform=ax1.transAxes, fontsize=34, va='top', ha='right')

ax1.tick_params(axis='both', labelsize=32, width=2.0, length=8)
for spine in ax1.spines.values():
    spine.set_linewidth(2.0)

# --- B. Upper right plot (b) ---
ax2 = fig.add_subplot(gs[0, 1])
p_s = {'Delta':1.0, 'eta_R':3e-8, 'eta_I':1e-8, 'J_R':1e-4, 'J_I':1e-4, 'g':3e-4, 'kappa':1e-4, 'J_Ig':3e-4, 'J_Il':1e-4}
sol_s = solve_ivp(
    coupled_system, (0, 4e5),
    np.concatenate(([1e-3, 1e-3*np.exp(1j*0.2*np.pi)], np.zeros(16, dtype=complex))),
    t_eval=np.linspace(1e5, 4e5, 2000),
    args=((p_s['g']-p_s['kappa']+p_s['J_Ig']-p_s['J_Il'])/2, 3e-8, 1e-8, 1e-4, 1e-4, 3e-4, 1e-4, 3e-4, 1e-4, 1.0)
)
y1s, y2s = np.real(sol_s.y[2,:]), np.real(sol_s.y[7,:])
ax2.plot(sol_s.t, y1s, color='red', lw=2.0, label=r'$\delta N_1$'); ax2.plot(sol_s.t, y2s, color='blue', lw=2.0, label=r'$\delta N_2$')
ax2.set_xlim(1e5, 4e5); ax2.set_ylim(min(y1s.min(), y2s.min())*0.8, max(y1s.max(), y2s.max())*1.2)

ax2.set_ylabel(r'$\delta N_i$', fontsize=34)
ax2.legend(loc='upper center', bbox_to_anchor=(0.3, 1.04), fontsize=28, ncol=2)
ax2.grid(True, alpha=0.2)

set_sci(ax2, labelsize_x=30, labelsize_y=30, offsetsize=28, axis='both')
# ==== Modified: font size of (b) increased to 34 ====
ax2.text(-0.06, 1.00, "(b)", transform=ax2.transAxes, fontsize=34, va='top', ha='right')

# --- C. Lower right plot (c) ---
ax3 = fig.add_subplot(gs[1, 1])
p_d = {k: (v*10 if k in ['J_R','J_I','g','kappa','J_Ig','J_Il'] else v) for k,v in p_s.items()}
sol_d = solve_ivp(
    coupled_system, (0, 4e5),
    np.concatenate(([1e-3, 1e-3*np.exp(1j*0.2*np.pi)], np.zeros(16, dtype=complex))),
    t_eval=np.linspace(3.5e5, 4e5, 5000),
    args=((p_d['g']-p_d['kappa']+p_d['J_Ig']-p_d['J_Il'])/2, 3e-8, 1e-8, 1e-3, 1e-3, 3e-3, 1e-3, 3e-3, 1e-3, 1.0)
)
y1d, y2d = np.real(sol_d.y[2,:]), np.real(sol_d.y[7,:])

scale_factor = 1e219
ax3.plot(sol_d.t, np.abs(y1d) / scale_factor, color='red', lw=2.0, label=r'$\delta N_1$')
ax3.plot(sol_d.t, np.abs(y2d) / scale_factor, color='blue', lw=2.0, label=r'$\delta N_2$')

ax3.set_xlim(3.5e5, 4e5)

ax3.set_xlabel(r'$(\kappa_0 t) /\hbar$', fontsize=34); ax3.set_ylabel(r'$\delta N_i$', fontsize=34)
ax3.set_yscale('log')
ax3.legend(loc='upper left', fontsize=28); ax3.grid(True, alpha=0.2)

set_sci(ax3, labelsize_x=30, offsetsize=28, axis='x')
ax3.tick_params(axis='y', labelsize=30) 

# ==== Modified: font size of (c) increased from 30 to 34, multiplier text from 28 to 32 ====
ax3.text(-0.06, 1.1, "(c)", transform=ax3.transAxes, fontsize=34, va='top', ha='right')
ax3.text(0.00, 1.1, r"$\times 10^{219}$", transform=ax3.transAxes, fontsize=32, va='top', ha='left')

